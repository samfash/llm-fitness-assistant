FROM python:3.11-slim
WORKDIR /app
COPY requirements.txt requirements-api.txt ./
RUN pip install --no-cache-dir -r requirements-api.txt
COPY . .
# run as an unprivileged user
RUN useradd --create-home app && chown -R app /app
USER app
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request as u; u.urlopen('http://127.0.0.1:8000/health', timeout=3)"
# secrets (HF_TOKEN, DATABASE_URL, ...) come from the environment, never from the image
CMD ["uvicorn", "api.api_server:app", "--host", "0.0.0.0", "--port", "8000"]
