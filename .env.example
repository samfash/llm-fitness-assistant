# =====================================================================================================
#  LLM Fitness Assistant: environment configuration
# =====================================================================================================
#  HOW TO USE THIS FILE
#   1. Replace every value that contains REPLACE_ME with your real value. Each one says where to get it.
#   2. Keep this file PRIVATE. It is in .gitignore. Never commit it and never paste it in public.
#   3. A value that still contains REPLACE_ME is treated as NOT SET, so a placeholder can never be
#      mistaken for a real credential.
#   4. Check your setup at any time:        python -m core.doctor
#      Before going live:                   python -m core.doctor --production
#      Also test the model token:           python -m core.doctor --live
#   5. On a Hugging Face Space do NOT upload this file. Add the same names and values under
#      Settings -> Variables and secrets instead (real environment variables always win over this file).
#   6. Put comments on their own line, never after a value. Remove the leading # to switch on an
#      optional setting (the value shown is the default).
# =====================================================================================================


# =====================================================================================================
#  1. REQUIRED TO GO LIVE
# =====================================================================================================

# --- Hugging Face access token (lets the app call the language model) -------------------------------
# WHERE TO GET IT: https://huggingface.co/settings/tokens -> Create new token -> type "Fine-grained"
#   -> tick "Make calls to Inference Providers" (the "Inference" preset does this) -> Create.
#   The token starts with hf_ and is shown only once. A token that can only download models will fail
#   with a 403 error. On a Space, add it as a SECRET named HF_TOKEN.
# WITHOUT IT: the app still runs, but only as a basic chat (no workout or meal logging).
HF_TOKEN=REPLACE_ME_hf_your_fine_grained_token

# --- Neon Postgres connection string (keeps your data when the Space restarts) ----------------------
# WHERE TO GET IT: https://console.neon.tech -> your project -> Connect -> choose your branch, database
#   and role -> switch ON "Connection pooling" -> copy the connection string.
#   It looks like: postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
#   Paste it WHOLE, exactly as Neon shows it (keep ?sslmode=require and anything after it).
#   On a Space, add it as a SECRET named DATABASE_URL.
# WITHOUT IT: the app uses a local SQLite file, which a free Space erases on every restart.
DATABASE_URL=postgresql://REPLACE_ME_USER:REPLACE_ME_PASSWORD@REPLACE_ME_ep-xxxx-pooler.REPLACE_ME_REGION.aws.neon.tech/REPLACE_ME_DBNAME?sslmode=require


# =====================================================================================================
#  2. MODEL AND COST (optional)
# =====================================================================================================

# Chat model used through Hugging Face Inference Providers. It MUST support tool calling.
# Verify a choice with:  python -m core.doctor --live
# HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# Prices, so the app can report dollar cost. Without this, tokens are counted but cost shows as "unknown".
# WHERE TO GET THEM: the pricing shown for your model/provider on its Hugging Face page. Units are USD per
# MILLION tokens. Keep it on ONE line. Replace the model id and the two numbers, then remove the leading #.
# MODEL_PRICES={"Qwen/Qwen2.5-7B-Instruct": {"input_per_mtok": REPLACE_ME, "output_per_mtok": REPLACE_ME}}


# =====================================================================================================
#  3. ACCESS CONTROL AND LIMITS (optional but recommended before sharing a link)
# =====================================================================================================

# 1 = anyone with the link can use the demo as a guest (guests share one daily token budget).
# 0 = only people with an API key can sign in (recommended for a private deployment).
# Create a key (it is printed ONCE):   python -m core.auth create your-name
# ALLOW_GUEST=1

# Requests per minute per user, and the burst size allowed before the limit applies.
# RATE_LIMIT_PER_MIN=20
# RATE_LIMIT_BURST=20

# Tokens each signed-in user may spend per day (resets 00:00 UTC). 0 = unlimited (not recommended).
# DAILY_TOKEN_BUDGET=200000
# Tokens ALL guests together may spend per day.
# GUEST_DAILY_TOKEN_BUDGET=100000

# Browser origins allowed to call the REST API (comma separated). Leave unset unless a website calls it.
# CORS_ORIGINS=https://your-site.example


# =====================================================================================================
#  4. REST API CLIENT (only if you run the separate FastAPI server and ui/ui_streamlit.py)
# =====================================================================================================

# Where your API is running.
# API_URL=http://127.0.0.1:8000/chat
# A key created with:  python -m core.auth create your-name
# API_KEY=REPLACE_ME_fa_key_printed_by_core.auth


# =====================================================================================================
#  5. OBSERVABILITY (optional)
# =====================================================================================================

# Append one JSON line per trace span to this file.
# TRACE_FILE=traces.jsonl
# 1 = also record message text in traces. Leave OFF unless you accept storing user messages.
# TRACE_CONTENT=0
# Send traces to an OpenTelemetry (OTLP) backend. Needs: pip install -r requirements-otel.txt
# WHERE TO GET IT: your tracing backend's documentation (it gives you an endpoint URL and auth headers).
# OTEL_EXPORTER_OTLP_ENDPOINT=https://REPLACE_ME_your-otlp-endpoint
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=REPLACE_ME
# OTEL_SERVICE_NAME=fitness-assistant


# =====================================================================================================
#  6. ADVANCED (leave these alone unless you know you need them)
# =====================================================================================================

# SQLite file used when DATABASE_URL is not set.
# FITNESS_DB_PATH=data/fitness.db
# Database connection pool: on/off and maximum size.
# DB_POOL=on
# DB_POOL_MAX=5
# Retrieval: use embedding search (on/off) and an optional reranker (0/1). Embeddings download a model.
# RAG_DENSE=on
# RAG_RERANK=0
# Safety layer on/off. Keep ON in production; "off" exists only for evaluation experiments.
# GUARDRAILS=on
# Folder with the USDA food CSV files.
# FOODDATA_DIR=fooddata
# 1 = never use tool calling (basic chat only).
# DISABLE_TOOLS=0

# =====================================================================================================
#  7. GITHUB ACTIONS SECRETS (these are NOT read from this file; set them in GitHub)
# =====================================================================================================
#  Repository -> Settings -> Secrets and variables -> Actions -> New repository secret:
#    HF_TOKEN   used to (a) push to your Hugging Face Space (needs WRITE access to the Space repo) and
#               (b) run the weekly live evaluation (needs "Make calls to Inference Providers").
#               Use a fine-grained token with both permissions, or edit the workflows to use two secrets.
# =====================================================================================================
